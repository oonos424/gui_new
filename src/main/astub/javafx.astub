import org.checkerframework.checker.nullness.qual.Nullable;
import org.checkerframework.checker.initialization.qual.UnknownInitialization;

// FXMLLoader.load() returns non-null when the FXML document has a root element, which is the
// universal case in this project. Marking as non-null avoids pervasive null-check noise at
// every call site; a null root would cause a NullPointerException before reaching any
// application code regardless.
package javafx.fxml;
class FXMLLoader {
    <T> T load() throws java.io.IOException;
    <T> @Nullable T getController();
}

package javafx.beans.property;
class ReadOnlyBooleanWrapper {
    ReadOnlyBooleanWrapper(@UnknownInitialization Object bean, String name, boolean initialValue);
}
class SimpleObjectProperty<T> {
    SimpleObjectProperty(@UnknownInitialization Object bean, String name, @Nullable T initialValue);
}

package javafx.scene;
class Node {
    final javafx.beans.property.ReadOnlyBooleanProperty hoverProperty(@UnknownInitialization Node this);
    final boolean isHover(@UnknownInitialization Node this);
    final void setStyle(@UnknownInitialization Node this, String value);
}

package javafx.scene.control;
class Labeled {
    final void setText(@UnknownInitialization Labeled this, @Nullable String value);
    final void setGraphic(@UnknownInitialization Labeled this, @Nullable javafx.scene.Node value);
}
class Cell<T> {
    final boolean isSelected(@UnknownInitialization Cell<T> this);
    final javafx.beans.property.ReadOnlyBooleanProperty selectedProperty(@UnknownInitialization Cell<T> this);
    protected void updateItem(@Nullable T item, boolean empty);
}
class Dialog<R> {
    // 355
    final void close(@UnknownInitialization Dialog<R> this);
    // 569
    final DialogPane getDialogPane(@UnknownInitialization Dialog<R> this);
    // 573
    final void setDialogPane(@UnknownInitialization Dialog<R> this, DialogPane value);
    // 721
    final void setResultConverter(@UnknownInitialization Dialog<R> this, Callback<ButtonType, R> value);
    // 731
    final ReadOnlyBooleanProperty showingProperty(@UnknownInitialization Dialog<R> this);
    // 770
    final void setResizable(@UnknownInitialization Dialog<R> this, boolean resizable);
    // 907
    final void setOnShowing(@UnknownInitialization Dialog<R> this, EventHandler<DialogEvent> value);
}

package javafx.util;
// StringConverter.toString() receives null when no item is selected in a ChoiceBox or ComboBox.
abstract class StringConverter<T> {
    abstract String toString(@Nullable T object);
}

package javafx.concurrent;
class Task<V> {
    @Nullable V getValue();
    @Nullable Throwable getException();
}
