import org.checkerframework.checker.nullness.qual.Nullable;
import org.checkerframework.checker.initialization.qual.UnknownInitialization;

// FXMLLoader.load() returns non-null when the FXML document has a root element, which is the
// universal case in this project. Marking as non-null avoids pervasive null-check noise at
// every call site; a null root would cause a NullPointerException before reaching any
// application code regardless.
package javafx.fxml;
class FXMLLoader {
    <T> T load() throws java.io.IOException;
    <T> T getController();
}

package javafx.scene.control;
class Dialog<R> {
    // 355
    final void close(@UnknownInitialization Dialog<R> this);
    // 569
    final DialogPane getDialogPane(@UnknownInitialization Dialog<R> this);
    // 573
    final void setDialogPane(@UnknownInitialization Dialog<R> this, DialogPane value);
    // 721
    final void setResultConverter(@UnknownInitialization Dialog<R> this, Callback<ButtonType, R> value);
    // 731
    final ReadOnlyBooleanProperty showingProperty(@UnknownInitialization Dialog<R> this);
    // 770
    final void setResizable(@UnknownInitialization Dialog<R> this, boolean resizable);
    // 907
    final void setOnShowing(@UnknownInitialization Dialog<R> this, EventHandler<DialogEvent> value);
}
